# Copy to server environment or private digital_creators_config.php (not committed).

APP_TIMEZONE=Asia/Kolkata

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=digital_creators
DB_USER=root
DB_PASS=

# wa.me link on marketing site only (no Meta API in this repo)
WHATSAPP_PUBLIC_NUMBER=918368142191

# WhatsJet — template thank-you after website form (preferred; disables duplicate webhook below)
WHATSJET_API_BASE=https://whatsapp.digitalcreatorss.com/api
WHATSJET_VENDOR_UID=
WHATSJET_API_TOKEN=
WHATSJET_TEMPLATE_NAME=enquiry_thank_you
WHATSJET_TEMPLATE_LANGUAGE=en
WHATSJET_CONTACT_GROUP=Website Form Leads

# Optional legacy webhook (ignored when WHATSJET_* is fully configured)
EXTERNAL_MESSAGING_ENABLED=0
EXTERNAL_MESSAGING_WEBHOOK_URL=
EXTERNAL_MESSAGING_API_KEY=
EXTERNAL_MESSAGING_PLATFORM_URL=

# SaaS (optional)
SAAS_STRICT_WEBHOOK=0
SAAS_APP_URL=https://yourdomain.com/app
CRM_CREDENTIALS_KEY=
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
SAAS_EXPOSE_VERIFY_TOKEN=0

# Razorpay (fill on server — never commit live secrets)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
