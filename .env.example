# Copy to server environment or private digital_creators_config.php (not committed).

APP_TIMEZONE=Asia/Kolkata

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=digital_creators
DB_USER=root
DB_PASS=

# wa.me link on marketing site only (no Meta API in this repo)
WHATSAPP_PUBLIC_NUMBER=

# Forward website form leads to your independent WhatsApp platform
EXTERNAL_MESSAGING_ENABLED=0
EXTERNAL_MESSAGING_WEBHOOK_URL=
EXTERNAL_MESSAGING_API_KEY=
# Optional: admin dashboard link to your messaging app
EXTERNAL_MESSAGING_PLATFORM_URL=

# SaaS (optional)
SAAS_STRICT_WEBHOOK=0
SAAS_APP_URL=https://yourdomain.com/app
CRM_CREDENTIALS_KEY=
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
SAAS_EXPOSE_VERIFY_TOKEN=0

# Razorpay (fill on server — never commit live secrets)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
