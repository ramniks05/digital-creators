# Extensionless API routes (Hostinger CDN redirects *.php → extensionless; rewrite serves PHP internally).
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

RewriteRule ^api/hook-wa/?$ api/hook-wa.php [L,QSA]
RewriteRule ^api/wa-messages/?$ api/wa-messages.php [L,QSA]
RewriteRule ^api/wa-health/?$ api/wa-health.php [L,QSA]
RewriteRule ^api/contact/?$ api/contact.php [L,QSA]

RewriteRule ^services/whatsapp-business-api/?$ whatsapp-business-api.php [L,QSA]
</IfModule>
