RewriteEngine On

# Keep POST/PUT/DELETE on .php endpoints (forms/API) — do not redirect them.
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.php$ - [L]

# Redirect external GET requests from /file.php to /file
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+(.+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=302,L]

# Map extensionless URLs internally back to PHP files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*?)/?$ $1.php [L]
